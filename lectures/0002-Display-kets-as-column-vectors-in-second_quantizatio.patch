     "def expval(op, n, N):\n",
     "    \"\"\"Expectation value <n| op |n> for the Fock state |n> in an N-dim basis.\"\"\"\n",
     "    ket = basis_state(n, N)\n",
-    "    return complex((ket.conj().T @ op @ ket).item())"
+    "    return complex((ket.conj().T @ op @ ket).item())\n",
+    "\n",
+    "def show_ket(label, ket, note=\"\"):\n",
+    "    \"\"\"Print a ket as a column vector (N x 1), with an optional note beside it.\"\"\"\n",
+    "    col = np.asarray(ket).reshape(-1, 1)          # kets are always columns\n",
+    "    lines = np.array2string(col).splitlines()\n",
+    "    prefix = label + \" = \"\n",
+    "    for i, line in enumerate(lines):\n",
+    "        lead = prefix if i == 0 else \" \" * len(prefix)\n",
+    "        tail = \"   \" + note if (note and i == 0) else \"\"\n",
+    "        print(lead + line + tail)\n",
+    "    print()"
    ]
